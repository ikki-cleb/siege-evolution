[resource]
script = ExtResource("1_2cwxv")
display_name = "1. Moon Landing"
layout = PackedStringArray("....S....", ".........", "..#...#..", ".........", "#.......#", "...#.#...", ".........", ".........", "...#.#...", "#.......#", ".........", "..#...#..", ".........", "....B....")
hand_value = PackedInt32Array(12, 15, 7, 0, 0, 0)
starting_coins = 40
wave_tips = PackedStringArray("The final frontier! Your pack plays exactly the same out here. Alien grubs crawl around your units; every kill drops coins.", "NEW: Blinkers teleport 3 tiles forward along their route every few seconds. Spread your attackers along the whole route, not one kill zone.", "Brood Pods burst into three spawnlings.", "Crusher Mechs ignore your maze and stomp through units (red line).", "Saucers fly straight in. Hoppers leap single walls, so build them two thick.", "Tunnelers dig under part of the route. Every trick you\'ve learned comes together here.", "UFO Bombers target your most valuable units. Keep anti-air nearby.", "Final wave! The Mothership waits at the end of this world.")
waves = Array[ExtResource("2_ps3ja")]([SubResource("Resource_vrgo5"), SubResource("Resource_32gqb"), SubResource("Resource_k1hih"), SubResource("Resource_3yyn2"), SubResource("Resource_1ev1g"), SubResource("Resource_lqe67"), SubResource("Resource_4jid4"), SubResource("Resource_k7twd")])
