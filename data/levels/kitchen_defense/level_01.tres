[resource]
script = ExtResource("2_c2nw2")
display_name = "1. Pantry Raid"
layout = PackedStringArray("....S....", ".........", ".#.....#.", ".........", "...#.#...", ".........", "##.....##", ".........", "...#.#...", ".........", ".#.....#.", ".........", ".........", "....B....")
hand_value = PackedInt32Array(12, 12, 7, 0, 0, 0)
starting_coins = 35
wave_tips = PackedStringArray("Bonus world! This kitchen is post-game: tighter maps and nastier waves. Sugar ants march around your units; every kill drops coins.", "NEW: Slugs are spillers. Every couple of tiles they slime the units right beside their route, and sticky units attack 40% slower until the wave ends.", "Spill counter: ranged attackers can fight from two tiles back and stay clean. Walls don\'t mind being sticky.", "Mouse Nests burst into three mice.", "Cockroaches ignore your maze and chew through units (red line).", "Fruit flies fly straight in. Keep anti-air near the cookie jar.", "Slugs and nests together. Kill spillers early, before they reach your best attackers.", "Final wave! The Rat King waits at the end of this world.")
background = ExtResource("1_lqego")
waves = Array[ExtResource("3_qv5dw")]([SubResource("Resource_cfuwi"), SubResource("Resource_mabcs"), SubResource("Resource_140ts"), SubResource("Resource_udlt6"), SubResource("Resource_0st4q"), SubResource("Resource_qbdig"), SubResource("Resource_pplua"), SubResource("Resource_nadmi")])
