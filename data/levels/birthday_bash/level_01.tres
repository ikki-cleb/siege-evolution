[resource]
script = ExtResource("2_0ydnx")
display_name = "1. Party Time"
layout = PackedStringArray("....S....", ".........", "..#...#..", ".........", "#...#...#", ".........", "..#...#..", ".........", "#...#...#", ".........", "..#...#..", ".........", ".........", "....B....")
hand_value = PackedInt32Array(12, 12, 7, 0, 0, 0)
starting_coins = 45
wave_tips = PackedStringArray("Bonus world! This party is post-game: tight maps and wild waves. Wind-up mice scurry around your units; every kill drops coins.", "NEW: Piñatas burst into a surprise when broken. It looks random, but the same wave always hides the same surprise.", "Break piñatas early, far from the cake, so their surprise has a long way to go.", "Party Bags burst into gumdrops. Bouncy Balls hop single walls, so build them two thick.", "Toy Robots ignore your maze and stomp through units (red line).", "Balloons float straight in. Water Balloons splash your most valuable units.", "Soda Spills soak the units beside their route: sticky units attack slower until the wave ends.", "Final wave! The Clown waits at the end of this world.")
background = ExtResource("1_q558q")
waves = Array[ExtResource("3_kjb3w")]([SubResource("Resource_b8kbr"), SubResource("Resource_4cq0f"), SubResource("Resource_hjnjb"), SubResource("Resource_4upnc"), SubResource("Resource_okpdp"), SubResource("Resource_bcm25"), SubResource("Resource_gtjic"), SubResource("Resource_ngxy5")])
