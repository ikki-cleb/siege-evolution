[resource]
script = ExtResource("2_dc0iq")
display_name = "1. Cornfield"
layout = PackedStringArray("....S....", ".........", "..#...#..", ".........", ".........", "#...#...#", ".........", ".........", "..#...#..", ".........", ".........", "#.......#", ".........", "....B....")
hand_value = PackedInt32Array(12, 15, 7, 0, 0, 0)
starting_coins = 26
wave_tips = PackedStringArray("Welcome to the farm! Your pack plays exactly the same at this scale. Rats walk around your units; every kill drops coins.", "Units that survived a wave can evolve. Anything placed this round refunds in full.", "NEW: Deer leap over any single unit tile (orange line). Build walls two tiles thick where you don\'t want them jumping.", "Coyote Packs scatter into three coyotes when killed.", "Wild Boars ignore your maze and charge through any unit in their way (red line).", "Crows fly straight to the farmhouse (blue dashes). Only some units can hit fliers.", "Gophers tunnel under part of the route, like the mole crickets. Guard the end of the route too.", "Final wave! Later levels bring elite versions, and the boss brings her cubs.")
background = ExtResource("1_muc3s")
waves = Array[ExtResource("3_s5iur")]([SubResource("Resource_nwqtr"), SubResource("Resource_5rau0"), SubResource("Resource_q0nrm"), SubResource("Resource_f1e3i"), SubResource("Resource_fmj6q"), SubResource("Resource_sdbkq"), SubResource("Resource_meujv"), SubResource("Resource_tpbta")])
