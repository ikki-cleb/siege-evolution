[resource]
script = ExtResource("2_qryt2")
display_name = "1. Garden Path"
layout = PackedStringArray("....S....", ".........", ".........", ".#.....#.", ".........", ".........", "...#.#...", ".........", ".........", ".#.....#.", ".........", ".........", ".........", "....B....")
hand_value = PackedInt32Array(12, 15, 7, 0, 0, 0)
starting_coins = 20
wave_tips = PackedStringArray("Termites walk around your units. Use walls to make their route longer, and put attackers beside it. Every kill drops coins.", "Units that survived a wave can evolve: tap one and pick a branch. Anything placed this round refunds in full.", "Mole Crickets walk 3 tiles, then tunnel under the next 6 tiles of the route and pop up further along. Defend deep, not just the entrance.", "Aphid Clusters burst into three aphids when killed. Units from earlier rounds only refund 50% if you remove them, so plan ahead.", "Rhino Beetles ignore your maze and ram through any unit in their way (red line).", "Mosquitoes fly straight to the anthill (blue dashes). Only some units can hit fliers.", "Units are repaired for free after every wave. Let nothing through for a bonus.", "Final wave! Later levels bring tougher elite versions, and the boss can tunnel too.")
background = ExtResource("1_bxtap")
waves = Array[ExtResource("3_bvlo3")]([SubResource("Resource_qkd38"), SubResource("Resource_ro5dd"), SubResource("Resource_pwl4s"), SubResource("Resource_o57ta"), SubResource("Resource_mi82c"), SubResource("Resource_vfcg6"), SubResource("Resource_3ip4j"), SubResource("Resource_l0uhy")])
