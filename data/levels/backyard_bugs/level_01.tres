[resource]
script = ExtResource("1_2tifa")
display_name = "1. Garden Path"
layout = PackedStringArray("....S....", ".........", ".........", ".#.....#.", ".........", ".........", "...#.#...", ".........", ".........", ".#.....#.", ".........", ".........", ".........", "....B....")
hand_value = PackedInt32Array(12, 15, 7, 0, 0, 0)
starting_coins = 20
wave_tips = PackedStringArray("New world, new scale! Your pack plays exactly the same here. Termites walk around your units; every kill drops coins.", "Units that survived a wave can evolve. Anything placed this round refunds in full.", "NEW: Mole Crickets walk 3 tiles, then tunnel under the next 6 tiles of the route and pop up further along. Defend deep, not just the entrance.", "Aphid Clusters burst into three aphids when killed.", "Rhino Beetles ignore your maze and ram through any unit in their way (red line).", "Mosquitoes fly straight to the anthill (blue dashes). Only some units can hit fliers.", "Burrowers and splitters together: keep attackers near the end of the route too.", "Final wave! Later levels bring elite versions, and the boss can tunnel too.")
waves = Array[ExtResource("2_bxtap")]([SubResource("Resource_uy261"), SubResource("Resource_qkd38"), SubResource("Resource_gvl2b"), SubResource("Resource_xjh0r"), SubResource("Resource_ngv3t"), SubResource("Resource_qd7hc"), SubResource("Resource_mdv16"), SubResource("Resource_xq6t0")])
