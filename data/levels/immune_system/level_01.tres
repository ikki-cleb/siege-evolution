[resource]
script = ExtResource("2_7niaj")
display_name = "1. First Infection"
layout = PackedStringArray("....S....", ".........", ".........", "..#...#..", ".........", ".........", "#.......#", ".........", ".........", "..#...#..", ".........", ".........", ".........", "....B....")
hand_value = PackedInt32Array(12, 15, 7, 0, 0, 0)
starting_coins = 20
wave_tips = PackedStringArray("New world, new scale: inside the body! Your pack plays exactly the same here. Rhinoviruses walk around your units; every kill drops coins.", "Units that survived a wave can evolve. Anything placed this round refunds in full.", "Bacteria split into two halves when killed.", "Nothing tunnels or jumps in here: every walker follows the route you build, so make it long.", "Parasite Worms ignore your maze and chew through any unit in their way (red line).", "Spores fly straight to the heart (blue dashes). Only some units can hit fliers.", "Splitters again: keep attackers near the end of the route too.", "Final wave! Later levels bring tougher elite versions, and the Superbug waits at the end.")
background = ExtResource("1_hqf0y")
waves = Array[ExtResource("3_gregp")]([SubResource("Resource_kppfn"), SubResource("Resource_24y2o"), SubResource("Resource_b7e11"), SubResource("Resource_scbq2"), SubResource("Resource_bju0m"), SubResource("Resource_gqva3"), SubResource("Resource_sitfq"), SubResource("Resource_65jww")])
