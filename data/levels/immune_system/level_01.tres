[resource]
script = ExtResource("1_fjv3w")
display_name = "1. First Infection"
layout = PackedStringArray("....S....", ".........", ".........", "..#...#..", ".........", ".........", "#.......#", ".........", ".........", "..#...#..", ".........", ".........", ".........", "....B....")
hand_value = PackedInt32Array(12, 15, 7, 0, 0, 0)
starting_atp = 20
show_path_preview = true
wave_tips = PackedStringArray("Rhinoviruses walk around your units. Use walls to make their route longer, and put attackers beside it. Every kill drops ATP.", "Units that survived a wave can evolve: tap one and pick a branch. Anything placed this round refunds in full.", "Bacteria split into two halves when killed.", "Units from earlier rounds only refund 50% if you remove them, so plan ahead.", "Parasite Worms ignore your maze and chew through any unit in their way (red line).", "Spores fly straight to the base (blue dashes). Only some units can hit fliers.", "Units are repaired for free after every wave. Let nothing through for a bonus.", "Smashers and fliers together: cover both the red line and the blue dashes.", "Big swarm incoming. Area and fast attacks shine here.", "Final wave! Later levels bring tougher elite versions of everything you\'ve seen.")
waves = Array[ExtResource("2_hqf0y")]([SubResource("Resource_d53cw"), SubResource("Resource_kppfn"), SubResource("Resource_bjffi"), SubResource("Resource_b7e11"), SubResource("Resource_0a0pd"), SubResource("Resource_hc34k"), SubResource("Resource_ue1w7"), SubResource("Resource_gw5fc"), SubResource("Resource_qtjbt"), SubResource("Resource_ikpi5")])
