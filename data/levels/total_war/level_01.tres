[resource]
script = ExtResource("2_nmct0")
display_name = "1. Sandbox"
layout = PackedStringArray("....S....", ".........", "..#...#..", ".........", "#.......#", "...#.#...", ".........", ".........", "...#.#...", "#.......#", ".........", "..#...#..", ".........", "....B....")
hand_value = PackedInt32Array(12, 15, 7, 0, 0, 0)
starting_coins = 40
wave_tips = PackedStringArray("Welcome to the toy war! Your pack plays exactly the same here. Toy soldiers march around your units; every kill drops coins.", "Units that survived a wave can evolve. Anything placed this round refunds in full.", "Troop Trucks unload three recruits when destroyed.", "Toy Tanks ignore your maze and roll through any unit in their way (red line).", "Paper Planes fly straight to the HQ (blue dashes). Only some units can hit fliers.", "NEW: Toy Bombers drop a bomb on your most valuable unit near their flight line. Shoot them down early, or spread out.", "Stunt Bikes jump any single unit tile, like the deer. Build walls two tiles thick.", "Final wave! Next level takes the war to the water.")
background = ExtResource("1_3wrda")
waves = Array[ExtResource("3_xkkll")]([SubResource("Resource_fgg07"), SubResource("Resource_4aj27"), SubResource("Resource_5mfri"), SubResource("Resource_ocgjx"), SubResource("Resource_7xmbh"), SubResource("Resource_e5ooq"), SubResource("Resource_1et5d"), SubResource("Resource_er13d")])
