[resource]
script = ExtResource("2_6rgqk")
display_name = "2. Bathtub Beach"
layout = PackedStringArray("S...N...S", "....~....", "..#.~~.#.", "....~~...", "....~....", ".#..~..#.", "...~~....", "...~~....", "....~....", "..#.~.#..", "....~~...", "....~~...", "....~....", "....B....")
hand_value = PackedInt32Array(12, 8, 7, 5, 0, 0)
starting_coins = 20
wave_tips = PackedStringArray("NEW: water lanes! Boats sail the blue water to your HQ, while landing troops march the land. Build your maze on land.", "Only your basic wall can go on water. There it becomes a net, or a mine if evolved for reflect. Nets push boats into the other lane but can never seal it.", "Cover the water lanes and the land route at the same time. Units can shoot boats from the shore.", "", "", "", "", "", "", "")
background = ExtResource("1_n4x5t")
waves = Array[ExtResource("3_3qm3i")]([SubResource("Resource_dec7w"), SubResource("Resource_ieh71"), SubResource("Resource_7x6jy"), SubResource("Resource_fd851"), SubResource("Resource_7meov"), SubResource("Resource_m1qfr"), SubResource("Resource_qiic1"), SubResource("Resource_q6pqq")])
